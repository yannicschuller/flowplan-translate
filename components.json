    {
      "id": "flowplan-app-store",
      "title": "Flowplan app · store listing",
      "repo": "yannicschuller/flowplan-app",
      "format": "txt-files",
      "source": "en",
      "reference": "de",
      "targets": [
        "fr",
        "zh"
      ],
      "files": [
        {
          "key": "app-store/{field}",
          "path": "store/app-store/{locale}/{field}.txt",
          "locales": {
            "en": "en-US",
            "de": "de-DE",
            "fr": "fr-FR",
            "zh": "zh-Hans"
          },
          "fields": [
            "name",
            "subtitle",
            "keywords",
            "promotional_text",
            "description"
          ]
        },
        {
          "key": "google-play/{field}",
          "path": "store/google-play/{locale}/{field}.txt",
          "locales": {
            "en": "en-US",
            "de": "de-DE",
            "fr": "fr-FR",
            "zh": "zh-CN"
          },
          "fields": [
            "title",
            "short_description",
            "full_description"
          ]
        }
      ],
      "placeholders": [],
      "limits": {
        "app-store/name": {
          "chars": 30
        },
        "app-store/subtitle": {
          "chars": 30
        },
        "app-store/keywords": {
          "bytes": 100,
          "keywords": true
        },
        "app-store/promotional_text": {
          "chars": 170
        },
        "app-store/description": {
          "chars": 4000,
          "multiline": true
        },
        "google-play/title": {
          "chars": 30
        },
        "google-play/short_description": {
          "chars": 80
        },
        "google-play/full_description": {
          "chars": 4000,
          "multiline": true
        }
      }
    },
