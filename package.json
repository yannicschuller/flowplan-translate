{
  "name": "flowplan-translate",
  "version": "0.1.0",
  "private": true,
  "description": "Translate Flowplan in the browser – reviewed translations go back to the repositories as pull requests.",
  "license": "AGPL-3.0-only",
  "homepage": "https://translate.flowplan.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/yannicschuller/flowplan-translate.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test --trace off",
    "audit": "npm audit --audit-level=low"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
