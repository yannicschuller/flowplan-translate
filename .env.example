# Public https address (OAuth callback, Origin check, Secure cookies).
TRANSLATE_URL=
# Where the SQLite database lives (the Docker image uses /app/data).
TRANSLATE_DATA_DIR=
# Reviewers besides yannicschuller: GitHub logins, comma-separated.
TRANSLATE_REVIEWERS=
# The GitHub App (README "GitHub App").
TRANSLATE_GITHUB_APP_ID=
TRANSLATE_GITHUB_CLIENT_ID=
TRANSLATE_GITHUB_CLIENT_SECRET=
# The App's private key: the PEM (line breaks may be written as \n) …
TRANSLATE_GITHUB_PRIVATE_KEY=
# … or a path to the .pem file instead.
TRANSLATE_GITHUB_PRIVATE_KEY_FILE=
# The App's webhook secret (signature of push events).
TRANSLATE_WEBHOOK_SECRET=
# Port of the server (default 3000).
PORT=
# Time zone for dates and times on the pages (IANA name, default Europe/Berlin).
TRANSLATE_TIME_ZONE=
